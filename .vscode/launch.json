    "version": "0.2.0",
    "configurations": [

       {
            "name": "Lancer tat.co.za (Live Server)",
            "type": "firefox",
            "request": "launch",
            "reAttach": true,
            "url": "http://127.0.0.1:5501/index.html",
            "webRoot": "${workspaceFolder}",
            "pathMappings": [{"url": "http://127.0.0.1:5501", "path": "${workspaceFolder}"}]
        }
        {
            "name": "Launch WebExtension",
            "type": "firefox",
            "request": "launch",
            "reAttach": true,
            "addonPath": "${workspaceFolder}"
        }
    ]
}