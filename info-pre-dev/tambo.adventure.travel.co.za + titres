        { label: "Adresse", value: "Quartier des Almadies, Dakar", type: "text" },
        { label: "Code postal", value: "10500", type: "text" },
        { label: "Ville", value: "Dakar", type: "text" },
        { label: "Pays", value: "Sénégal", type: "text" },
