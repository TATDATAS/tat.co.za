            align-items: baseline;
            gap: 0.5rem;
            flex-wrap: wrap;
        }
        .field-label {
            font-size: 0.7rem;
            font-weight: 600;
            color: #FFE3B5;
            text-transform: uppercase;
            min-width: 85px;
        }
        .field-value {
            background: rgba(255, 245, 225, 0.1);
            border: none;
            border-bottom: 1px solid rgba(240, 180, 80, 0.5);
            color: #FFF;
            font-family: 'Inter', monospace;
            font-size: 0.85rem;
            padding: 0.3rem 0;
            flex: 1;
            outline: none;
            transition: 0.2s;
