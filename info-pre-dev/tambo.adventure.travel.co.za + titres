    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
            background: linear-gradient(145deg, #C29A6B 0%, #A67B4A 25%, #7A5C3A 50%, #4A6B3C 75%, #2D4A2A 100%);
            /* Terrain d'Afrique : ocre -> sable -> brun terre -> vert savane profond */
            position: relative;
            overflow-x: hidden;
        }

        /* Overlay grain subtil pour texture naturelle */
        body::before {
            content: "";
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" opacity="0.08"><path d="M70 40 L90 20 L110 40 L130 30 L120 50 L140 70 L110 80 L90 70 L70 80 L40 70 L60 50 L50 30 Z" fill="white"/><circle cx="150" cy="140" r="12" fill="white"/><circle cx="40" cy="160" r="8" fill="white"/><path d="M160 80 L180 70 L190 90 L170 100 Z" fill="white"/><circle cx="30" cy="50" r="5" fill="white"/></svg>');
            background-repeat: repeat;
            pointer-events: none;
        }

        /* PARTICULES ANIMÉES (savane poussière / lucioles) */
        .particle {
            position: fixed;
            background: rgba(255, 235, 190, 0.6);
            border-radius: 50%;
            pointer-events: none;
            filter: blur(2px);
            animation: floatUp 12s infinite ease-in-out;
            z-index: 0;
        }

        @keyframes floatUp {
            0% { transform: translateY(100vh) translateX(0) scale(0.5); opacity: 0; }
            10% { opacity: 0.7; }
            90% { opacity: 0.5; }
            100% { transform: translateY(-20vh) translateX(40px) scale(1.2); opacity: 0; }
        }

        /* layout principal */
        .app-container {
            position: relative;
            z-index: 5;
            max-width: 1400px;
            margin: 0 auto;
            padding: 2rem 2rem;
        }

        /* BARRE DE NAVIGATION GLASS */
        .glass-nav {
            background: rgba(255, 248, 235, 0.2);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-radius: 2rem;
            padding: 0.8rem 2rem;
            margin-bottom: 2.5rem;
            border: 1px solid rgba(255, 245, 225, 0.3);
            box-shadow: 0 8px 20px rgba(0,0,0,0.15);
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
        }

        .logo-area h1 {
            font-size: 1.7rem;
            font-weight: 700;
            background: linear-gradient(135deg, #FFF2DF, #FFD89A);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            letter-spacing: -0.3px;
        }
        .logo-area p {
            font-size: 0.7rem;
            color: rgba(255,245,220,0.9);
            letter-spacing: 1px;
        }

        .nav-links {
            display: flex;
            gap: 2rem;
        }
        .nav-links a {
            color: #FEF3E2;
            text-decoration: none;
            font-weight: 500;
            font-size: 0.95rem;
            transition: 0.2s;
            border-bottom: 1px solid transparent;
        }
        .nav-links a:hover {
            border-bottom-color: #FBBA6C;
            color: #FFE3B5;
        }

        /* GRILLE DE CARTES GLASS + AFRIQUE */
        .hero-section {
            display: flex;
            flex-wrap: wrap;
            gap: 2rem;
            margin-bottom: 3.5rem;
        }

        .glass-card {
            background: rgba(22, 20, 18, 0.25);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border-radius: 2rem;
            border: 1px solid rgba(255, 220, 150, 0.4);
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.2);
