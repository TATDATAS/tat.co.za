            font-weight: 600;
            margin-bottom: 1.5rem;
            color: #FFF4E0;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .destinations-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 1.8rem;
            margin-bottom: 3rem;
        }

        .destination-card {
            background: rgba(20, 18, 16, 0.3);
            backdrop-filter: blur(12px);
            border-radius: 1.5rem;
            overflow: hidden;
            border: 1px solid rgba(240, 180, 80, 0.4);
            transition: all 0.3s;
        }
        .destination-img {
            height: 150px;
            background-size: cover;
            background-position: center;
            position: relative;
        }
        .destination-img::after {
            content: "";
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 60px;
            background: linear-gradient(to top, rgba(0,0,0,0.5), transparent);
