        { label: "Taux TVA", value: "18%", type: "text" },
        { label: "Seg.", value: "Premium Partenaire", type: "text" }
    ];

	// Ne pas modifier cette fonction (construction automatique)
    function buildForm() {
        const container = document.getElementById('dynamicFormGrid');
        container.innerHTML = '';
        fields.forEach(f => {
            const fieldDiv = document.createElement('div');
            fieldDiv.className = 'field';
            const labelSpan = document.createElement('span');
            labelSpan.className = 'field-label';
            labelSpan.innerText = f.label + ' :';
            const inputEl = document.createElement('input');
            inputEl.type = f.type === 'email' ? 'email' : (f.type === 'tel' ? 'tel' : 'text');
            inputEl.className = 'field-value';
            inputEl.value = f.value;
            inputEl.readOnly = true;
            fieldDiv.appendChild(labelSpan);
            fieldDiv.appendChild(inputEl);
            container.appendChild(fieldDiv);
        });
        window.allInputs = document.querySelectorAll('#dynamicFormGrid .field-value');
    }

    buildForm();
</script>

